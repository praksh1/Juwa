{
  "expo": {
    "name": "Juwa",
    "slug": "juwa",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "juwa",
    "backgroundColor": "#0A0710",
    "splash": {
      "backgroundColor": "#0A0710",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.juwa.app"
    },
    "android": {
      "package": "com.juwa.app",
      "adaptiveIcon": { "backgroundColor": "#0A0710" }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "themeColor": "#0A0710",
      "backgroundColor": "#0A0710",
      "shortName": "Juwa",
      "description": "A free-to-play social casino. Gold Coins have no cash value.",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "lang": "en"
    }
  }
}
