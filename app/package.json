{
  "name": "@juwa/app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/ensure-workspace-deps.mjs && expo export --platform web --output-dir dist && node scripts/finalize-web.mjs dist",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@juwa/economy": "*",
    "@juwa/money": "*",
    "@juwa/ui": "*",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@supabase/supabase-js": "^2.111.0",
    "expo": "~51.0.39",
    "expo-linear-gradient": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "^15.2.0",
    "react-native-web": "^0.19.13"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3"
  }
}
