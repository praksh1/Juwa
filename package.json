{
  "name": "juwa",
  "private": true,
  "version": "0.1.0",
  "description": "Juwa \u2014 casino-style gaming platform",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "build": "npm run build --workspace @juwa/money && npm run build --workspace @juwa/ui && npm run build --workspace @juwa/engine",
    "test": "npm run build && node --test \"packages/*/dist/**/*.test.js\"",
    "typecheck": "npm run build && tsc -p app/tsconfig.json",
    "rtp": "npm run build && node packages/engine/dist/tools/rtp.js",
    "verify": "npm run test && npm run typecheck"
  },
  "engines": {
    "node": ">=20"
  }
}